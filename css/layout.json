        "0": "Use the armed tool"
      }
    },
    {
      "sel": "div:nth-child(5) > div:nth-child(4) > span.controls-text",
      "text": {
        "0": "Cancel/deselect the active tool or building move"
      }
    },
    {
      "sel": "div:nth-child(5) > div:nth-child(5) > span.controls-text",
      "text": {
        "0": "Move a building, or drag one fish onto another to merge or splice them"
      }
    },
    {
      "sel": "div:nth-child(5) > div:nth-child(7) > span.controls-text",
      "text": {
        "0": "Replace the building under a placement (including group placements)"
      }
    },
    {
      "sel": "div:nth-child(5) > div:nth-child(9) > span.controls-text",
      "text": {
        "0": "Box-select buildings, then click to place them (Right-click or Q puts them back)"
      }
